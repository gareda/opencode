{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-6-luna",
  "formatter": true,
  "mcp": {
    "servers": {
      "azure": {
        "type": "local",
        "command": ["npx", "-y", "@azure/mcp@latest", "server", "start", "--read-only"],
        "environment": {
          "AZURE_TOKEN_CREDENTIALS": "AzureCliCredential",
          "AZURE_TENANT_ID": "{env:AZURE_MCP_TENANT_ID}",
          "AZURE_SUBSCRIPTION_ID": "{env:AZURE_MCP_SUBSCRIPTION_ID}",
        },
      },
      "azure-devops": {
        // https://github.com/microsoft/azure-devops-mcp#using-domains-local-server
        // https://github.com/microsoft/azure-devops-mcp/blob/main/docs/TOOLSET.md
        "type": "local",
        "command": [
          "npx", "-y", "@azure-devops/mcp@latest", "{env:AZURE_DEVOPS_MCP_ORG}", "--authentication", "azcli",
          "-d", "repositories", "pipelines", "work", "work-items", "search",
        ],
        "environment": {
          "ado_mcp_project": "{env:AZURE_DEVOPS_MCP_PROJECT}",
          "ado_mcp_team": "{env:AZURE_DEVOPS_MCP_TEAM}",
        },
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "X-MCP-Toolsets": "repos,issues",
          "X-MCP-Readonly": "true",
        },
      },
      "github-pr": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "X-MCP-Toolsets": "pull_requests",
        },
      },
      "microsoft-docs": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp",
      },
      "terraform": {
        "type": "local",
        "command": ["terraform-mcp-server", "stdio", "--toolsets=registry"],
      }
    },
  },
  "policies": [ // https://opencode.ai/docs/policies/
    { "action": "tool.use", "resource": "azure-devops_*:*", "effect": "deny" },
    { "action": "tool.use", "resource": "azure-devops_repo_*:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_pipelines_build:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_pipelines_build_log:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_pipelines_definition:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_pipelines_run:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_pipelines_artifact:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_work:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_wit_work_item:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_wit_query:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_wit_work_item_attachment:*", "effect": "allow" },
    { "action": "tool.use", "resource": "azure-devops_search_workitem:*", "effect": "allow" },
  ],
}